# Database
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://nexus:nexus@localhost:5672

# Auth
JWT_SECRET=your-jwt-secret-here
MAGIC_LINK_SECRET=your-magic-link-secret-here
SUPERADMIN_EMAILS=admin@example.com

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Mercado Pago
MP_ACCESS_TOKEN=your-mp-token
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# Metrics
METRICS_BEARER_TOKEN=your-metrics-token

# Engine gRPC
ENGINE_GRPC_ADDR=localhost:50051
